/* =========================================================================
   UnityRateControl - Modern UI Toolkit Stylesheet
   ========================================================================= */

:root {
    --rc-accent: #2e8b57;
    --rc-accent-light: #4cd964;
    --rc-cyan: #4da3d4;
    --rc-bg: #222226;
    --rc-card-bg: #2a2a2e;
    --rc-card-header: #323236;
    --rc-border: #3c3c42;
    --rc-text: #e6e6e6;
    --rc-text-dim: #999999;
    --rc-pass: #3ec972;
    --rc-warn: #f5a623;
    --rc-fail: #e84c4c;
    --rc-info: #33bbf5;
}

/* Base Root Container */
.rc-root {
    flex-grow: 1;
    background-color: var(--rc-bg);
    color: var(--rc-text);
    padding: 10px 14px;
    font-size: 12px;
}

/* Header Banner */
.rc-header {
    background-color: var(--rc-card-bg);
    border-bottom-width: 2px;
    border-bottom-color: var(--rc-accent);
    padding: 12px 14px;
    margin-bottom: 10px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

.rc-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.rc-header-left {
    flex-direction: row;
    align-items: center;
}

.rc-header-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-right: 8px;
}

.rc-header-version {
    background-color: rgba(46, 139, 87, 0.2);
    border-color: var(--rc-accent);
    border-width: 1px;
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--rc-accent-light);
}

.rc-header-subtitle {
    font-size: 11px;
    color: var(--rc-text-dim);
    margin-top: 4px;
}

/* Toolbar Buttons */
.rc-toolbar-actions {
    flex-direction: row;
    align-items: center;
}

.rc-toolbar-btn {
    height: 26px;
    font-size: 11px;
    margin-left: 6px;
    padding: 0 10px;
    border-radius: 4px;
}

/* Card Container */
.rc-card {
    background-color: var(--rc-card-bg);
    border-width: 1px;
    border-color: var(--rc-border);
    border-radius: 6px;
    margin-bottom: 10px;
    padding: 10px 12px;
}

.rc-card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 6px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--rc-border);
}

.rc-card-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #ffffff;
}

.rc-card-subtitle {
    font-size: 11px;
    color: var(--rc-text-dim);
    margin-top: 2px;
}

/* Status Badges */
.rc-badge {
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 10px;
    -unity-font-style: bold;
    align-self: center;
}

.rc-badge-pass {
    background-color: rgba(62, 201, 114, 0.18);
    border-width: 1px;
    border-color: var(--rc-pass);
    color: var(--rc-pass);
}

.rc-badge-warn {
    background-color: rgba(245, 166, 35, 0.18);
    border-width: 1px;
    border-color: var(--rc-warn);
    color: var(--rc-warn);
}

.rc-badge-fail {
    background-color: rgba(232, 76, 76, 0.18);
    border-width: 1px;
    border-color: var(--rc-fail);
    color: var(--rc-fail);
}

.rc-badge-info {
    background-color: rgba(51, 187, 245, 0.18);
    border-width: 1px;
    border-color: var(--rc-info);
    color: var(--rc-info);
}

/* Callout Box */
.rc-callout {
    padding: 8px 10px;
    border-radius: 4px;
    margin-top: 6px;
    margin-bottom: 8px;
    border-left-width: 4px;
    font-size: 11px;
}

.rc-callout-info {
    background-color: rgba(51, 187, 245, 0.12);
    border-left-color: var(--rc-info);
    color: #e0eeff;
}

.rc-callout-warn {
    background-color: rgba(245, 166, 35, 0.12);
    border-left-color: var(--rc-warn);
    color: #fff2d6;
}

.rc-callout-pass {
    background-color: rgba(62, 201, 114, 0.12);
    border-left-color: var(--rc-pass);
    color: #dffff0;
}

/* Action Button */
.rc-btn {
    height: 28px;
    font-size: 11px;
    border-radius: 4px;
    padding: 0 10px;
    margin-right: 4px;
    margin-bottom: 4px;
}

.rc-btn-primary {
    background-color: #235c3c;
    color: #ffffff;
    -unity-font-style: bold;
}

.rc-btn-primary:hover {
    background-color: #2e7a4f;
}

.rc-btn-secondary {
    background-color: #2e2e34;
    border-color: var(--rc-border);
    border-width: 1px;
    color: var(--rc-text);
}

.rc-btn-secondary:hover {
    background-color: #383840;
}

.rc-btn-danger {
    background-color: rgba(232, 76, 76, 0.2);
    border-color: var(--rc-fail);
    border-width: 1px;
    color: #ff9999;
}

.rc-btn-danger:hover {
    background-color: rgba(232, 76, 76, 0.35);
}

.rc-btn-success {
    background-color: rgba(62, 201, 114, 0.2);
    border-color: var(--rc-pass);
    border-width: 1px;
    color: #a3ffc7;
}

.rc-btn-success:hover {
    background-color: rgba(62, 201, 114, 0.35);
}

/* ---------------- TABS TOOLBAR ---------------- */
.rc-tab-toolbar {
    flex-direction: row;
    background-color: #1e1e22;
    border-color: var(--rc-border);
    border-width: 1px;
    border-radius: 6px;
    padding: 3px;
    margin-bottom: 10px;
}

.rc-tab-btn {
    flex-grow: 1;
    border-width: 0;
    border-radius: 4px;
    background-color: transparent;
    color: var(--rc-text-dim);
    font-size: 11.5px;
    -unity-font-style: bold;
    padding: 6px 10px;
    margin-left: 2px;
    margin-right: 2px;
    transition-duration: 0.15s;
}

.rc-tab-btn:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #ffffff;
}

.rc-tab-btn-active {
    background-color: var(--rc-accent);
    color: #ffffff;
}

.rc-tab-btn-active:hover {
    background-color: #2e7a4f;
    color: #ffffff;
}

/* ---------------- METRICS ROW ---------------- */
.rc-metrics-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.rc-metric-card {
    flex-grow: 1;
    background-color: var(--rc-card-bg);
    border-color: var(--rc-border);
    border-width: 1px;
    border-radius: 6px;
    padding: 8px 10px;
    margin-left: 3px;
    margin-right: 3px;
    align-items: center;
}

.rc-metric-val {
    font-size: 19px;
    -unity-font-style: bold;
    color: #ffffff;
}

.rc-metric-lbl {
    font-size: 10px;
    color: var(--rc-text-dim);
    margin-top: 2px;
}

/* ---------------- DIAGNOSTIC ROWS ---------------- */
.rc-check-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.04);
}

.rc-check-row:hover {
    background-color: rgba(255, 255, 255, 0.02);
}

.rc-check-info {
    flex-direction: column;
    flex-grow: 1;
    margin-right: 12px;
}

.rc-check-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--rc-text);
}

.rc-check-desc {
    font-size: 11px;
    color: var(--rc-text-dim);
    margin-top: 2px;
    white-space: normal;
}

.rc-check-actions {
    flex-direction: row;
    align-items: center;
}

/* ---------------- PROGRESS BAR ---------------- */
.rc-progress-container {
    flex-direction: column;
    margin-top: 6px;
    margin-bottom: 8px;
}

.rc-progress-label-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 3px;
}

.rc-progress-bar {
    height: 14px;
    background-color: #1a1a1e;
    border-color: var(--rc-border);
    border-width: 1px;
    border-radius: 4px;
    overflow: hidden;
}

.rc-progress-fill {
    height: 100%;
    background-color: var(--rc-accent-light);
    border-radius: 3px;
}

.rc-code-box {
    background-color: #1b1b20;
    border-color: #383842;
    border-width: 1px;
    border-radius: 4px;
    padding: 8px 10px;
    margin-top: 6px;
    margin-bottom: 6px;
}
